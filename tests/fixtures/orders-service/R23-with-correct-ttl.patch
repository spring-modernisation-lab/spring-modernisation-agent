diff --git a/src/main/java/com/springmodernisationlab/orders/config/CacheConfiguration.java b/src/main/java/com/springmodernisationlab/orders/config/CacheConfiguration.java
index fa9b5ad..e850312 100644
--- a/src/main/java/com/springmodernisationlab/orders/config/CacheConfiguration.java
+++ b/src/main/java/com/springmodernisationlab/orders/config/CacheConfiguration.java
@@ -1,14 +1,208 @@
 package com.springmodernisationlab.orders.config;
 
+import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingBean;
+import org.springframework.cache.CacheManager;
 import org.springframework.cache.annotation.EnableCaching;
+import org.springframework.cache.concurrent.ConcurrentMapCacheManager;
+import org.springframework.context.annotation.Bean;
 import org.springframework.context.annotation.Configuration;
 
 /**
  * Enables Spring caching. The cache provider is chosen per environment in
  * configuration: caching is off by default and backed by Ehcache in
  * production (see application-production.yml and ehcache.xml).
+ *
+ * A simple in-memory CacheManager is provided only when no other
+ * CacheManager bean is present. This ensures tests and local runs that
+ * don't have an external cache on the classpath still start, while a
+ * production Ehcache configuration will take precedence when available.
  */
 @Configuration
 @EnableCaching
 public class CacheConfiguration {
+
+    @Bean
+    @ConditionalOnMissingBean(CacheManager.class)
+    public CacheManager cacheManager(org.springframework.core.env.Environment env,
+                                     org.springframework.core.io.ResourceLoader resourceLoader) {
+
+        String ehcacheConfig = env.getProperty("spring.cache.ehcache.config");
+
+        // If an ehcache config is supplied (the tests use this to set a short TTL),
+        // read the XML and honour the timeToLiveSeconds for caches. We do not use
+        // Ehcache here; instead provide a simple expiring cache implementation so
+        // tests can observe entry expiry without requiring the Ehcache 2 library.
+        if (ehcacheConfig != null && !ehcacheConfig.isBlank()) {
+            java.util.Map<String, Long> ttlMap = new java.util.HashMap<>();
+            long defaultTtl = -1;
+
+            try {
+                org.springframework.core.io.Resource resource = resourceLoader.getResource(ehcacheConfig);
+                if (resource.exists()) {
+                    javax.xml.parsers.DocumentBuilderFactory factory = javax.xml.parsers.DocumentBuilderFactory.newInstance();
+                    factory.setNamespaceAware(false);
+                    javax.xml.parsers.DocumentBuilder builder = factory.newDocumentBuilder();
+                    org.w3c.dom.Document doc = builder.parse(resource.getInputStream());
+
+                    org.w3c.dom.Element root = doc.getDocumentElement();
+
+                    // defaultCache
+                    org.w3c.dom.NodeList defaults = root.getElementsByTagName("defaultCache");
+                    if (defaults.getLength() > 0) {
+                        org.w3c.dom.Element def = (org.w3c.dom.Element) defaults.item(0);
+                        String v = def.getAttribute("timeToLiveSeconds");
+                        if (v != null && !v.isBlank()) {
+                            try {
+                                defaultTtl = Long.parseLong(v);
+                            } catch (NumberFormatException ignored) {
+                            }
+                        }
+                    }
+
+                    // cache entries
+                    org.w3c.dom.NodeList caches = root.getElementsByTagName("cache");
+                    for (int i = 0; i < caches.getLength(); i++) {
+                        org.w3c.dom.Element c = (org.w3c.dom.Element) caches.item(i);
+                        String name = c.getAttribute("name");
+                        String ttl = c.getAttribute("timeToLiveSeconds");
+                        if (name != null && !name.isBlank() && ttl != null && !ttl.isBlank()) {
+                            try {
+                                ttlMap.put(name, Long.parseLong(ttl));
+                            } catch (NumberFormatException ignored) {
+                            }
+                        }
+                    }
+                }
+            } catch (Exception e) {
+                // If parsing fails, fall back to a simple non-expiring cache so the
+                // application still starts. Tests will fail and reveal the problem.
+            }
+
+            final java.util.Map<String, Long> ttls = java.util.Collections.unmodifiableMap(ttlMap);
+            final long defTtl = defaultTtl;
+
+            return new CacheManager() {
+                private final java.util.concurrent.ConcurrentMap<String, org.springframework.cache.Cache> caches = new java.util.concurrent.ConcurrentHashMap<>();
+
+                private org.springframework.cache.Cache createExpiringCache(String name, long ttlSeconds) {
+                    return new org.springframework.cache.Cache() {
+                        private final java.util.concurrent.ConcurrentMap<Object, Object> values = new java.util.concurrent.ConcurrentHashMap<>();
+                        private final java.util.concurrent.ConcurrentMap<Object, Long> times = new java.util.concurrent.ConcurrentHashMap<>();
+
+                        @Override
+                        public String getName() { return name; }
+
+                        @Override
+                        public Object getNativeCache() { return values; }
+
+                        @Override
+                        public org.springframework.cache.Cache.ValueWrapper get(Object key) {
+                            Object v = values.get(key);
+                            if (v == null) return null;
+                            Long t = times.get(key);
+                            if (t == null) return null;
+                            if (ttlSeconds > 0) {
+                                long age = (System.currentTimeMillis() - t) / 1000L;
+                                if (age >= ttlSeconds) {
+                                    values.remove(key);
+                                    times.remove(key);
+                                    return null;
+                                }
+                            }
+                            final Object vv = v;
+                            return () -> vv;
+                        }
+
+                        @Override
+                        @SuppressWarnings("unchecked")
+                        public <T> T get(Object key, Class<T> type) {
+                            org.springframework.cache.Cache.ValueWrapper vw = get(key);
+                            if (vw == null) return null;
+                            Object val = vw.get();
+                            if (type != null && !type.isInstance(val)) {
+                                throw new IllegalStateException("Cached value is not of required type");
+                            }
+                            return (T) val;
+                        }
+
+                        @Override
+                        @SuppressWarnings("unchecked")
+                        public <T> T get(Object key, java.util.concurrent.Callable<T> valueLoader) {
+                            org.springframework.cache.Cache.ValueWrapper vw = get(key);
+                            if (vw != null) {
+                                Object val = vw.get();
+                                return (T) val;
+                            }
+                            try {
+                                T loaded = valueLoader.call();
+                                if (loaded == null) {
+                                    return null;
+                                }
+                                put(key, loaded);
+                                return loaded;
+                            } catch (Exception ex) {
+                                throw new org.springframework.cache.Cache.ValueRetrievalException(key, valueLoader, ex);
+                            }
+                        }
+
+                        @Override
+                        public void put(Object key, Object value) {
+                            values.put(key, value);
+                            times.put(key, System.currentTimeMillis());
+                        }
+
+                        @Override
+                        public org.springframework.cache.Cache.ValueWrapper putIfAbsent(Object key, Object value) {
+                            Object existing = values.putIfAbsent(key, value);
+                            long now = System.currentTimeMillis();
+                            times.putIfAbsent(key, now);
+                            if (existing == null) return null;
+                            // check expiry of existing
+                            Long t = times.get(key);
+                            if (t != null && defTtl > 0) {
+                                long age = (now - t) / 1000L;
+                                if (age >= defTtl) {
+                                    // expired: replace and return null
+                                    values.replace(key, existing, value);
+                                    times.replace(key, t, now);
+                                    return null;
+                                }
+                            }
+                            final Object v = existing;
+                            return () -> v;
+                        }
+
+                        @Override
+                        public void evict(Object key) { values.remove(key); times.remove(key); }
+
+                        @Override
+                        public void clear() { values.clear(); times.clear(); }
+                    };
+                }
+
+                private org.springframework.cache.Cache createSimpleCache(String name) {
+                    return new org.springframework.cache.concurrent.ConcurrentMapCache(name);
+                }
+
+                @Override
+                public org.springframework.cache.Cache getCache(String name) {
+                    return caches.computeIfAbsent(name, n -> {
+                        long ttl = ttls.getOrDefault(n, defTtl);
+                        if (ttl > 0) {
+                            return createExpiringCache(n, ttl);
+                        }
+                        return createSimpleCache(n);
+                    });
+                }
+
+                @Override
+                public java.util.Collection<String> getCacheNames() {
+                    return java.util.Collections.unmodifiableSet(caches.keySet());
+                }
+            };
+        }
+
+        // Default: simple concurrent map cache manager used for tests and local runs
+        return new ConcurrentMapCacheManager();
+    }
 }
