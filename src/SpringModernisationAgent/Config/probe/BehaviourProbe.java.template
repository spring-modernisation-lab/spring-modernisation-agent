/**
 * Generated by the Spring modernisation pipeline: records this application's
 * behaviour for the behaviour contract (docs/system-design.md §3). Written
 * just before the probe runs and deleted straight afterwards; never part of a
 * patch. Uses only APIs common to Spring Boot 2.7 and 3.x.
 */
@SpringBootTest
@AutoConfigureMockMvc
{{ACTIVE_PROFILES}}
class {{CLASS}} {

    private static final String PROFILE = "{{PROFILE}}";
    private static final String BASE_PACKAGE = "{{PACKAGE}}";
    private static final String[] SETTINGS = { {{SETTINGS}} };
    private static final String[] PRINCIPALS = { {{PRINCIPALS}} };

    // id | start types (simple names, comma-separated) | fields (name or name:unit, comma-separated)
    private static final String[][] BEANS = { {{BEANS}} };

    private static final String[] CACHE_TTL_FIELDS = { {{CACHE_TTL}} };
    private static final String[] CACHE_SIZE_FIELDS = { {{CACHE_SIZE}} };

    private static final int MAX_DEPTH = 7;
    private static final int MAX_VISITED = 20000;

    @Autowired
    private ApplicationContext context;

    @Autowired
    private MockMvc mvc;

    @Test
    void record() throws Exception {
        Map<String, String> items = new TreeMap<>();
        items.put("B-CTX-" + PROFILE, "starts");
        recordSettings(items);
        recordAccess(items);
        recordBeans(items);
        recordCaches(items);

        Path out = Paths.get(System.getProperty("migration.probe.out")).resolve(PROFILE + ".tsv");
        Files.createDirectories(out.getParent());
        List<String> lines = new ArrayList<>();

        for (Map.Entry<String, String> item : items.entrySet()) {
            lines.add(clean(item.getKey()) + "\t" + clean(item.getValue()));
        }

        Files.write(out, lines, StandardCharsets.UTF_8);
    }

    private void recordSettings(Map<String, String> items) {
        Environment environment = context.getEnvironment();

        for (String key : SETTINGS) {
            String value;

            try {
                value = environment.getProperty(key);
            } catch (RuntimeException exception) {
                value = "error " + exception.getClass().getSimpleName();
            }

            items.put("B-CFG-" + PROFILE + "-" + key, value == null ? "(unset)" : value);
        }
    }

    /** Every endpoint of the application's own controllers, with and without a trailing slash, as each principal. */
    private void recordAccess(Map<String, String> items) {
        RequestMappingHandlerMapping mapping;

        try {
            mapping = context.getBean("requestMappingHandlerMapping", RequestMappingHandlerMapping.class);
        } catch (RuntimeException exception) {
            return;
        }

        for (Map.Entry<RequestMappingInfo, HandlerMethod> entry : mapping.getHandlerMethods().entrySet()) {
            if (!entry.getValue().getBeanType().getName().startsWith(BASE_PACKAGE)) {
                continue;
            }

            Set<RequestMethod> methods = entry.getKey().getMethodsCondition().getMethods();

            if (methods.isEmpty()) {
                methods = EnumSet.of(RequestMethod.GET);
            }

            for (String pattern : entry.getKey().getPatternValues()) {
                if (pattern.contains("*")) {
                    continue;
                }

                String path = pattern.replaceAll("\\{[^}]*}", "probe");
                List<String> targets = new ArrayList<>();
                targets.add(path);

                if (!path.endsWith("/")) {
                    targets.add(path + "/");
                }

                for (RequestMethod method : methods) {
                    for (String target : targets) {
                        for (String principal : PRINCIPALS) {
                            items.put(
                                    "B-SEC-" + PROFILE + "-" + method.name() + " " + target + "-" + principal,
                                    perform(method, target, principal));
                        }
                    }
                }
            }
        }
    }

    private String perform(RequestMethod method, String target, String principal) {
        try {
            MockHttpServletRequestBuilder request =
                    MockMvcRequestBuilders.request(HttpMethod.valueOf(method.name()), target);

            if (method == RequestMethod.POST || method == RequestMethod.PUT || method == RequestMethod.PATCH) {
                request.contentType(MediaType.APPLICATION_JSON).content("{}");
            }

            if (!"anonymous".equals(principal)) {
                {{AUTHENTICATE}}
            }

            return String.valueOf(mvc.perform(request).andReturn().getResponse().getStatus());
        } catch (Exception exception) {
            return "error " + rootCause(exception).getClass().getSimpleName();
        }
    }

    private void recordBeans(Map<String, String> items) {
        for (String[] bean : BEANS) {
            Set<String> types = new HashSet<>(Arrays.asList(bean[1].split(",")));
            String value = "unavailable";

            for (String name : context.getBeanDefinitionNames()) {
                Object instance;

                try {
                    if (!context.isSingleton(name)) {
                        continue;
                    }

                    instance = context.getBean(name);
                } catch (RuntimeException exception) {
                    continue;
                }

                if (instance == null || !isA(instance.getClass(), types)) {
                    continue;
                }

                String found = find(instance, bean[2].split(","));

                if (found != null) {
                    value = found;
                    break;
                }
            }

            items.put("B-BEAN-" + PROFILE + "-" + bean[0], value);
        }
    }

    private void recordCaches(Map<String, String> items) {
        Map<String, CacheManager> managers;

        try {
            managers = context.getBeansOfType(CacheManager.class);
        } catch (RuntimeException exception) {
            items.put("B-CACHE-" + PROFILE + "-names", "error " + exception.getClass().getSimpleName());
            return;
        }

        if (managers.size() != 1) {
            items.put("B-CACHE-" + PROFILE + "-names", managers.isEmpty() ? "(no cache manager)" : "error " + managers.size() + " cache managers");
            return;
        }

        CacheManager manager = managers.values().iterator().next();
        List<String> names = new ArrayList<>(manager.getCacheNames());
        java.util.Collections.sort(names);
        items.put("B-CACHE-" + PROFILE + "-names", String.join(",", names));

        for (String name : names) {
            Cache cache = manager.getCache(name);
            Object nativeCache = cache == null ? null : cache.getNativeCache();
            String ttl = nativeCache == null ? null : find(nativeCache, CACHE_TTL_FIELDS);
            String size = nativeCache == null ? null : find(nativeCache, CACHE_SIZE_FIELDS);
            items.put("B-CACHE-" + PROFILE + "-" + name + ".timeToLive", ttl == null ? "unavailable" : ttl);
            items.put("B-CACHE-" + PROFILE + "-" + name + ".maxEntries", size == null ? "unavailable" : size);
        }
    }

    /**
     * Breadth-first search of an object graph for the first meaningful value
     * of one of the named fields: not null, and not negative (which HTTP
     * clients use for "not set"). Spring's own objects are only entered at
     * the root, so the search stays inside the library being inspected.
     */
    private static String find(Object root, String[] fieldSpecs) {
        Map<String, String> units = new TreeMap<>();

        for (String spec : fieldSpecs) {
            String[] parts = spec.trim().split(":");
            units.put(parts[0], parts.length > 1 ? parts[1] : "");
        }

        Deque<Object[]> queue = new ArrayDeque<>();
        Map<Object, Boolean> seen = new IdentityHashMap<>();
        queue.add(new Object[] { root, 0 });

        while (!queue.isEmpty() && seen.size() < MAX_VISITED) {
            Object[] next = queue.poll();
            Object current = next[0];
            int depth = (Integer) next[1];

            if (current == null || seen.containsKey(current)) {
                continue;
            }

            seen.put(current, Boolean.TRUE);

            if (current instanceof Collection) {
                for (Object element : (Collection<?>) current) {
                    queue.add(new Object[] { element, depth + 1 });
                }

                continue;
            }

            if (current instanceof Map) {
                for (Object element : ((Map<?, ?>) current).values()) {
                    queue.add(new Object[] { element, depth + 1 });
                }

                continue;
            }

            Class<?> type = current.getClass();

            if (type.isArray() || isPlatform(type) || (depth > 0 && type.getName().startsWith("org.springframework."))) {
                continue;
            }

            for (Class<?> declaring = type; declaring != null && declaring != Object.class; declaring = declaring.getSuperclass()) {
                for (Field field : declaring.getDeclaredFields()) {
                    if (Modifier.isStatic(field.getModifiers())) {
                        continue;
                    }

                    Object value;

                    try {
                        field.setAccessible(true);
                        value = field.get(current);
                    } catch (Exception | LinkageError exception) {
                        continue;
                    }

                    if (units.containsKey(field.getName())) {
                        String described = describe(value, current, field, units.get(field.getName()));

                        if (described != null) {
                            return described;
                        }
                    }

                    if (value != null && depth < MAX_DEPTH && !isPlatform(value.getClass())) {
                        queue.add(new Object[] { value, depth + 1 });
                    } else if (value instanceof Collection || value instanceof Map) {
                        queue.add(new Object[] { value, depth + 1 });
                    }
                }
            }
        }

        return null;
    }

    /** A value in a comparable form: times in milliseconds ("30000ms"); null when it isn't meaningful. */
    private static String describe(Object value, Object owner, Field field, String unit) {
        if (value == null) {
            return null;
        }

        if (value instanceof Duration) {
            long millis = ((Duration) value).toMillis();
            return millis < 0 ? null : millis + "ms";
        }

        try {
            // HttpClient 5's TimeValue and Timeout
            Method toMilliseconds = value.getClass().getMethod("toMilliseconds");
            long millis = ((Number) toMilliseconds.invoke(value)).longValue();
            return millis < 0 ? null : millis + "ms";
        } catch (Exception exception) {
            // not a time value
        }

        if (value instanceof Number) {
            long number = ((Number) value).longValue();

            if (number < 0) {
                return null;
            }

            String name = field.getName();

            if ("s".equals(unit) || name.endsWith("Seconds")) {
                return (number * 1000) + "ms";
            }

            if ("ms".equals(unit) || name.endsWith("Ms") || name.endsWith("Millis")) {
                return number + "ms";
            }

            if ("ns".equals(unit) || name.endsWith("Nanos")) {
                return TimeUnit.NANOSECONDS.toMillis(number) + "ms";
            }

            // HttpClient 4 keeps a time with a TimeUnit declared next to it.
            TimeUnit sibling = timeUnitDeclaredWith(owner, field);

            return sibling == null ? String.valueOf(number) : sibling.toMillis(number) + "ms";
        }

        return String.valueOf(value);
    }

    private static TimeUnit timeUnitDeclaredWith(Object owner, Field field) {
        for (Field candidate : field.getDeclaringClass().getDeclaredFields()) {
            if (candidate.getType() == TimeUnit.class && !Modifier.isStatic(candidate.getModifiers())) {
                try {
                    candidate.setAccessible(true);
                    return (TimeUnit) candidate.get(owner);
                } catch (Exception | LinkageError exception) {
                    return null;
                }
            }
        }

        return null;
    }

    private static boolean isA(Class<?> type, Set<String> simpleNames) {
        for (Class<?> current = type; current != null; current = current.getSuperclass()) {
            if (simpleNames.contains(current.getSimpleName())) {
                return true;
            }

            for (Class<?> implemented : current.getInterfaces()) {
                if (isA(implemented, simpleNames)) {
                    return true;
                }
            }
        }

        return false;
    }

    private static boolean isPlatform(Class<?> type) {
        String name = type.getName();
        return type.isPrimitive() || type.isEnum() || name.startsWith("java.") || name.startsWith("javax.")
                || name.startsWith("jakarta.") || name.startsWith("jdk.") || name.startsWith("sun.")
                || name.startsWith("com.sun.") || name.startsWith("org.slf4j.") || name.startsWith("ch.qos.");
    }

    private static Throwable rootCause(Throwable throwable) {
        Throwable current = throwable;

        while (current.getCause() != null && current.getCause() != current) {
            current = current.getCause();
        }

        return current;
    }

    private static String clean(String text) {
        return text.replace('\t', ' ').replace('\r', ' ').replace('\n', ' ');
    }
}
